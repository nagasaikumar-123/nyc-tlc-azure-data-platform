{
	"name": "DS_ADLS_TLC_Parquet",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_NYC_TLC",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"taxi_type": {
				"type": "string"
			},
			"year": {
				"type": "string"
			},
			"month": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().taxi_type, '_tripdata_', dataset().year,'-',dataset().month,'.parquet')",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat('raw/',dataset().taxi_type,'/year=',dataset().year, \n'/month=', dataset().month)",
					"type": "Expression"
				},
				"fileSystem": "nyc-tlc"
			},
			"compressionCodec": "none"
		},
		"schema": []
	}
}