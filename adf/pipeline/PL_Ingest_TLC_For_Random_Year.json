{
	"name": "PL_Ingest_TLC_2024",
	"properties": {
		"activities": [
			{
				"name": "ForEach_Files",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('files')",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 4,
					"activities": [
						{
							"name": "Copy data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "PreserveHierarchy"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_HTTP_TLC_Binary",
									"type": "DatasetReference",
									"parameters": {
										"taxi_type": {
											"value": "@item().files",
											"type": "Expression"
										},
										"year": {
											"value": "2024",
											"type": "Expression"
										},
										"month": {
											"value": "@item().month",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_TLC_Binary",
									"type": "DatasetReference",
									"parameters": {
										"taxi_type": {
											"value": "@item().taxi_type",
											"type": "Expression"
										},
										"year": {
											"value": "2024",
											"type": "Expression"
										},
										"month": {
											"value": "@variables('month')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"variables": {
			"year": {
				"type": "String",
				"defaultValue": "2024"
			},
			"files": {
				"type": "String",
				"defaultValue": "[{\"taxi_type\":\"yellow\"},{\"taxi_type\":\"green\"},{\"taxi_type\":\"fhv\"},{\"taxi_type\":\"fhvhv\"}]"
			},
			"month": {
				"type": "String",
				"defaultValue": "[\"01\",\"02\",\"03\",\"04\",\"05\",\"06\",\"07\",\"08\",\"09\",\"10\",\"11\",\"12\"]"
			}
		},
		"annotations": []
	}
}