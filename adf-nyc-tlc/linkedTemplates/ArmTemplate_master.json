{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-nyc-tlc"
		},
		"LS_ADLS_NYC_TLC_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://nycrawdatazone.dfs.core.windows.net/"
		},
		"LS_HTTP_TLC_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://d37ci6vzurychx.cloudfront.net/trip-data/"
		},
		"LS_HTTP_TLC_Misc_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://d37ci6vzurychx.cloudfront.net/misc/"
		},
		"LS_KeyVault_NYC_TLC_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-nyc-tlc.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-nyc-tlc_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_HTTP_TLC_properties_typeProperties_url": {
						"value": "[parameters('LS_HTTP_TLC_properties_typeProperties_url')]"
					},
					"LS_HTTP_TLC_Misc_properties_typeProperties_url": {
						"value": "[parameters('LS_HTTP_TLC_Misc_properties_typeProperties_url')]"
					},
					"LS_KeyVault_NYC_TLC_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_NYC_TLC_properties_typeProperties_baseUrl')]"
					},
					"LS_ADLS_NYC_TLC_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_NYC_TLC_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}